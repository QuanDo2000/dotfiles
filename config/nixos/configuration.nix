# NixOS system configuration for these dotfiles.
#
# `dotfile packages` rebuilds the repo flake. Per-machine values (username,
# hostname, timezone, stateVersion) live in ../host.nix.
#
# hardware-configuration.nix is machine-generated by the NixOS installer and
# tracked for this host so flake evaluation stays pure.
{ config, pkgs, ... }:

let
  machine = import ../host.nix;
in
{
  imports = [
    ./common.nix
    ../hardware-configuration.nix
  ];

  # --- System core ---------------------------------------------------------
  console = {
    font = "ter-v32n";
    packages = [ pkgs.terminus_font ];
  };
  networking.networkmanager.enable = true;

  services.openssh = {
    enable = true;
    openFirewall = true;
    settings = {
      PermitRootLogin = "no";
    };
  };

  # --- Boot ----------------------------------------------------------------
  boot.loader.systemd-boot.enable = true;
  boot.loader.systemd-boot.configurationLimit = 10;  # cap boot menu / ESP usage
  boot.loader.efi.canTouchEfiVariables = true;

  # --- User ----------------------------------------------------------------
  services.gnome.gnome-keyring.enable = true;
  programs.gnupg.agent.pinentryPackage = pkgs.pinentry-gnome3;
  users.users.${machine.username}.extraGroups = [ "wheel" "networkmanager" "video" ];
  home-manager.extraSpecialArgs = {
    desktop = true;
    personalApps = true;
    obsidianSync = true;
    googleDriveSync = true;
  };

  # --- Desktop: Hyprland + greetd login ------------------------------------
  hardware.graphics.enable = true;
  services.xserver.videoDrivers = [ "nvidia" ];
  hardware.nvidia = {
    modesetting.enable = true;
    powerManagement.enable = true;
    open = true;
    package = config.boot.kernelPackages.nvidiaPackages.stable;
  };

  programs.hyprland = {
    enable = true;
    withUWSM = true;
  };
  security.pam.services.hyprlock = { };

  programs.thunar = {
    enable = true;
    plugins = with pkgs; [ thunar-archive-plugin thunar-volman ];
  };
  services.gvfs.enable = true;
  services.tumbler.enable = true;
  services.udisks2.enable = true;
  environment.systemPackages = [ pkgs.xarchiver ];
  environment.etc."opt/chrome/policies/managed/dotfiles.json".text =
    builtins.toJSON { BackgroundModeEnabled = false; };

  # Audio (PipeWire) and screenshare/file-picker portals — hardware-independent.
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    pulse.enable = true;
  };
  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-hyprland ];
  };

  services.greetd = {
    enable = true;
    settings.default_session = {
      command = "${pkgs.tuigreet}/bin/tuigreet --time --remember --asterisks --width 60 --cmd '${pkgs.uwsm}/bin/uwsm start -e -D Hyprland hyprland.desktop'";
      user = "greeter";
    };
  };

  # --- Input method: fcitx5 ------------------------------------------------
  i18n.inputMethod = {
    enable = true;
    type = "fcitx5";
    fcitx5.addons = with pkgs; [
      qt6Packages.fcitx5-chinese-addons
      qt6Packages.fcitx5-unikey
    ];
  };

  # --- Fonts ---------------------------------------------------------------
  fonts.packages = with pkgs; [ nerd-fonts.fira-code ];

}
