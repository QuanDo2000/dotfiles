{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "max",
    "agentOverrides": {
      "advisor": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      }
    }
  },
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "skills": [
    "~/.agents/skills"
  ],
  "packages": [
    "npm:pi-mcp-extension@1.5.0",
    "npm:@dietrichgebert/ponytail@4.8.4",
    "npm:pi-hermes-memory@0.7.23",
    "npm:@ff-labs/pi-fff@0.9.6",
    "npm:pi-web-access",
    "npm:pi-subagents@0.40.0"
  ],
  "lastChangelogVersion": "0.80.6",
  "theme": "dark",
  "editorPaddingX": 0,
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "hideThinkingBlock": true,
  "collapseChangelog": true
}
