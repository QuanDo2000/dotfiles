{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "defaultThinking": "xhigh",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/*"
      ]
    },
    "agentOverrides": {
      "advisor": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "xhigh"
      },
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      }
    }
  },
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "skills": [
    "~/.agents/skills"
  ],
  "packages": [
    "npm:pi-mcp-extension@1.5.0",
    "npm:@dietrichgebert/ponytail@4.8.4",
    "npm:pi-hermes-memory@0.7.23",
    "npm:@ff-labs/pi-fff@0.10.1",
    "npm:pi-web-access",
    "npm:pi-subagents@0.40.0"
  ],
  "lastChangelogVersion": "0.80.6",
  "theme": "dark",
  "editorPaddingX": 0,
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "hideThinkingBlock": true,
  "collapseChangelog": true
}
