#!/usr/bin/env bash
set -euo pipefail

# Global variables (used in sourced scripts)
export DRY=false
export QUIET=false
export FORCE=false
# Portable readlink -f (macOS lacks GNU readlink -f)
_resolve() {
  local f="$0"
  while [ -L "$f" ]; do
    local d; d="$(cd -P "$(dirname "$f")" && pwd)"
    f="$(readlink "$f")"; [[ "$f" != /* ]] && f="$d/$f"
  done
  echo "$(cd -P "$(dirname "$f")" && pwd)/$(basename "$f")"
}
if [[ -n "${DOTFILES_DIR:-}" ]]; then
  DOTFILES_DIR="$(cd "$DOTFILES_DIR" && pwd)"
else
  DOTFILES_DIR="$(cd "$(dirname "$(_resolve)")" && pwd)"
fi
export DOTFILES_DIR
REPO_URL="https://github.com/QuanDo2000/dotfiles.git"
ORIGINAL_ARGS=("$@")

SCRIPTS_DIR="$DOTFILES_DIR/scripts"

# Validate that DOTFILES_DIR actually contains the repo we need. We only
# check for the scripts/ directory — a git check would break valid installs
# where the repo is owned by a different UID (e.g. read-only bind mount in
# a container) because git refuses to operate on such directories.
if [[ ! -d "$SCRIPTS_DIR" ]]; then
  # The renderer is unavailable when the checkout itself is missing.
  printf '  [FAIL] %s\n         %s\n' \
    "$SCRIPTS_DIR not found — $DOTFILES_DIR does not look like a dotfiles checkout." \
    "Remove it or set DOTFILES_DIR to a valid clone of $REPO_URL." >&2
  exit 1
fi

# Source all modules
source "$SCRIPTS_DIR/utils.sh"
source "$SCRIPTS_DIR/platform.sh"
source "$SCRIPTS_DIR/packages.sh"
source "$SCRIPTS_DIR/releases.sh"
source "$SCRIPTS_DIR/pins.sh"
source "$SCRIPTS_DIR/doctor.sh"
source "$SCRIPTS_DIR/obsidian.sh"

function update_repo {
  info "Updating dotfiles repo..."
  if [[ "$DRY" == "false" && "${DOTFILE_REEXEC:-false}" != "true" ]]; then
    cd "$DOTFILES_DIR" || return
    git pull --rebase --autostash || fail "Failed to pull dotfiles repo"
    DOTFILE_REEXEC=true exec "$DOTFILES_DIR/dotfile" "${ORIGINAL_ARGS[@]}"
  fi
  success "Finished updating repo"
}

function _ensure_update_environment {
  [[ "$DRY" == "false" ]] || return 0
  if [[ "${DOTFILE_UPDATE_ENV:-}" != true ]]; then
    DOTFILE_UPDATE_ENV=true nix develop -L "path:$DOTFILES_DIR" -c \
      bash "$DOTFILES_DIR/dotfile" "${ORIGINAL_ARGS[@]}"
    exit 0
  fi
  command -v python3 >/dev/null || fail "Pinned update environment is missing python3"
}

# One supervisor retains the full transcript across Git and Nix re-execution.
# Logs are private because native tool output can contain machine-local details.
_run_logged_update() (
  local log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfile/logs" log
  log="$(umask 077; mkdir -p "$log_dir" && mktemp "$log_dir/update-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")" \
    || fail "Cannot create update log in $log_dir"
  printf 'Update log: %s\n' "$log"
  # Keep screen output byte-for-byte; strip terminal escapes only from the log.
  # A named pipe lets Bash 3 wait for the filter and report write failures.
  local log_pipe="$log.pipe" log_filter_pid log_filter_status
  mkfifo -m 600 "$log_pipe" || fail "Cannot create update log pipe"
  trap 'rm -f -- "$log_pipe" || printf "Could not remove log pipe: %s\n" "$log_pipe" >&2' EXIT
  LC_ALL=C sed $'s/\033\\[[0-?]*[ -/]*[@-~]//g' < "$log_pipe" > "$log" &
  log_filter_pid=$!
  local statuses
  set +e
  (
    printf 'Update started: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    DOTFILE_UPDATE_LOG="$log" bash "$(_resolve)" "${ORIGINAL_ARGS[@]}"
    status=$?
    printf 'Update finished: %s; exit status: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$status"
    if [[ "$status" != 0 ]]; then
      printf 'Full update log: %s\n' "$log"
      printf 'For a failed Nix build, use: nix log /nix/store/<failed-derivation>.drv\n'
      printf 'Use the .drv path from the error above; reading its log does not rebuild it.\n'
    fi
    exit "$status"
  ) 7>&2 2>&1 | tee "$log_pipe"
  statuses=("${PIPESTATUS[@]}")
  wait "$log_filter_pid"
  log_filter_status=$?
  set -e
  [[ "${statuses[0]}" == 0 ]] || return "${statuses[0]}"
  [[ "${statuses[1]}" == 0 ]] || return "${statuses[1]}"
  return "$log_filter_status"
) 6>&1

function run_checked_flow {
  local pull_repo="$1"
  local precheck="$2"
  local operation="$3"
  shift 3
  [[ "$precheck" == "true" ]] \
    && DOTFILE_DOCTOR_SKIP_NIX_EVAL=true DOTFILE_DOCTOR_SKIP_NEOVIM_RUNTIME=true doctor
  if [[ "$pull_repo" == "true" ]]; then
    if [[ "$DRY" == "false" ]] && _dependency_update_markers_conflict; then
      fail "Conflicting pending dependency updates require manual review"
    elif [[ "$DRY" == "false" && "$operation" == "update_packages" ]]; then
      if _dependency_update_pending; then
        info "Resuming pending dependency update without pulling repository"
      elif _dependency_update_pending ai; then
        fail "Full update requires finishing pending AI dependency update first"
      else
        _require_clean_dependency_tree
        update_repo
      fi
    elif [[ "$DRY" == "false" && "$operation" == "update_ai" ]]; then
      if _dependency_update_pending ai; then
        info "Resuming pending AI dependency update without pulling repository"
      elif _dependency_update_pending; then
        fail "AI update requires finishing pending full dependency update first"
      else
        _require_clean_dependency_tree
        update_repo
      fi
    else
      update_repo
    fi
  fi
  case "$operation" in
    update_packages|update_ai) _ensure_update_environment ;;
  esac
  "$operation" "$@"
  DOTFILE_DOCTOR_SKIP_NIX_EVAL=true doctor
}

function setup_dotfiles {
  info "Setting up dotfiles..."
  run_checked_flow true false install_packages
  if [[ "$(detect_platform)" == mac ]]; then
    setup_pi_auth
  fi
  success "Done!"
}

function setup_pi_auth {
  info "Checking Pi Codex subscription and OpenRouter authentication..."
  [[ "$DRY" == "true" ]] && return 0
  nix develop "path:$DOTFILES_DIR" -c python3 "$SCRIPTS_DIR/pi_auth.py"
}

function setup_rex_auth {
  is_linux || fail "Rex package token setup is supported on Linux only"
  if [[ "$DRY" == true ]]; then
    info "Would securely prompt for and validate the Rex token, then save root-only /etc/nix/netrc"
    return
  fi
  local python
  python="$(_rex_auth_python)" || fail "Cannot prepare Python for Rex token setup"
  sudo "$python" "$SCRIPTS_DIR/rex_auth.py" || fail "Rex token setup failed"
}

function usage {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS] [COMMAND]

Commands:
  all         Run full setup (default)
  update [ai] Refresh all managed dependency pins and validate
              Install native prerequisites and activate current profile
              Update only AI tools and configs with 'update ai'
  packages    Install system packages only
  symlinks    Activate Home Manager config on Debian/Arch (also applies other user settings)
  upgrade     Upgrade native system packages
  obsidian    Bootstrap Obsidian Sync login and vault setup
  rex-auth    Securely prompt for and validate the Rex package token (Linux)
  pi-auth     Set up missing Pi Codex subscription and OpenRouter logins
  lix-installer
              Update pinned Lix installer checksums
  obsidian-headless
              Update pinned Obsidian Headless package
  doctor [--fast]
              Detect dotfile and Nix issues
  check       Run full repository checks

Options:
  -d, --dry     Dry run (no changes made)
  -f, --force   Overwrite existing files
  -q, --quiet   Hide routine dotfile progress; keep warnings and prompts
               Native subprocess output is unchanged
  -h, --help    Show this help message
EOF
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
  -d | --dry)
    DRY=true
    shift
    ;;
  -f | --force)
    FORCE=true
    shift
    ;;
  -q | --quiet)
    QUIET=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

# Run command
case "${1:-all}" in
all)
  [[ $# -le 1 ]] || fail "Unexpected all argument: ${2:-}"
  if [[ "$DRY" == "false" ]] && { _dependency_update_pending || _dependency_update_pending ai; }; then
    fail "Pending dependency update must be reviewed before setup"
  fi
  setup_dotfiles
  ;;
update)
  if [[ "$DRY" == false && -z "${DOTFILE_UPDATE_LOG:-}" ]]; then
    _run_logged_update
    exit 0
  fi
  if [[ -n "${DOTFILE_UPDATE_LOG:-}" ]]; then
    set -E
    trap 'printf "Failed (exit %s) at %s:%s: %s\n" "$?" "${BASH_SOURCE[0]}" "$LINENO" "$BASH_COMMAND" >&2' ERR
  fi
  case "${2:-}" in
    "") run_checked_flow true true update_packages ;;
    ai)
      [[ $# -eq 2 ]] || fail "Unexpected update argument: ${3:-}"
      run_checked_flow true true update_ai
      ;;
    *) fail "Unknown update target: $2" ;;
  esac
  ;;
packages)
  [[ $# -eq 1 ]] || fail "Unexpected packages argument: ${2:-}"
  if [[ "$DRY" == "false" ]] && { _dependency_update_pending || _dependency_update_pending ai; }; then
    fail "Pending dependency update must be reviewed before package installation"
  fi
  run_checked_flow false false install_packages
  ;;
symlinks)
  [[ $# -eq 1 ]] || fail "Unexpected symlinks argument: ${2:-}"
  platform="$(detect_platform)"
  case "$platform" in
    debian|arch)
      if [[ "$DRY" == "false" ]]; then
        _load_nix_profile
        command -v nix >/dev/null 2>&1 || fail "Nix is required; run dotfile packages to install prerequisites"
      fi
      ;;
  esac
  case "$platform" in
    debian) DOTFILE_FLAKE_REF="path:$DOTFILES_DIR" _home_manager_switch linux ;;
    arch)   DOTFILE_FLAKE_REF="path:$DOTFILES_DIR" _home_manager_switch arch-server ;;
    nixos)  fail "NixOS links are managed by nixos-rebuild; use the normal setup flow" ;;
    *)      fail "Standalone symlinks is supported only on Debian/Arch; use the normal setup flow" ;;
  esac
  ;;
upgrade)
  [[ $# -eq 1 ]] || fail "Unexpected upgrade argument: ${2:-}"
  upgrade_system_packages
  ;;
obsidian)
  [[ $# -eq 1 ]] || fail "Unexpected obsidian argument: ${2:-}"
  setup_obsidian
  ;;
rex-auth)
  [[ $# -eq 1 ]] || fail "Unexpected rex-auth argument: ${2:-}"
  setup_rex_auth
  ;;
pi-auth)
  [[ $# -eq 1 ]] || fail "Unexpected pi-auth argument: ${2:-}"
  setup_pi_auth
  ;;
lix-installer)
  [[ $# -eq 1 ]] || fail "Unexpected lix-installer argument: ${2:-}"
  _ensure_update_environment
  update_lix_installer_pins
  ;;
obsidian-headless)
  [[ $# -eq 1 ]] || fail "Unexpected obsidian-headless argument: ${2:-}"
  _ensure_update_environment
  update_obsidian_headless_release
  ;;
check)
  [[ $# -eq 1 ]] || fail "Unexpected check argument: ${2:-}"
  bash "$SCRIPTS_DIR/check.sh"
  ;;
doctor)
  [[ $# -le 2 ]] || fail "Unexpected doctor argument: ${3:-}"
  case "${2:-}" in
    "") ;;
    --fast) export DOTFILE_DOCTOR_SKIP_NIX_EVAL=true ;;
    *) fail "Unexpected doctor argument: $2" ;;
  esac
  doctor
  ;;
*)
  fail "Unknown command: $1"
  ;;
esac
